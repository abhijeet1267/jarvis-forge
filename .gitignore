# =============================================================================
# Vantage / JARVIS Forge — repository hygiene
#
# The rule this file follows: a *source tree* is committed; anything a tool can
# regenerate (builds, caches, vendored interpreters, logs) or that carries a
# secret is not. A fresh clone must build and run from what is here, and nothing
# here may leak a credential.
# =============================================================================

# --- Python -----------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Environment & secrets (never commit a real credential) ------------------
.env
.env.*
!.env.example
*.key
*.pem
# Throwaway self-signed fixtures the Android pinning contract test loads
# (CN=vantage-pin-test / vantage-pin-wrong). They are test data, not secrets;
# the Android unit suite fails without them.
!android/app/src/test/resources/pinning-test-cert.pem
!android/app/src/test/resources/pinning-test-wrong.pem
*.p12
*.pfx
secrets/
credentials.json
*credentials*.json

# --- macOS app (Swift Package) ---------------------------------------------
macos/Vantage/.build/
macos/Vantage/.swiftpm/
macos/Vantage/Vantage.app/
macos/Vantage/stale/
macos/Vantage/*.xcodeproj/xcuserdata/
macos/Vantage/*.xcworkspace/xcuserdata/
# An offscreen-render screenshot kept as verification evidence (not a build output).
!macos/artifacts/

# --- iOS app (Swift Package) -----------------------------------------------
ios/VantageAI/.build/
ios/VantageAI/.swiftpm/
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/**/DerivedData/
ios/**/build/

# --- Android (Gradle) -------------------------------------------------------
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
android/**/*.iml
android/**/xcuserdata/
# Gradle wrapper is a build tool, not output — keep it:
!android/gradle/wrapper/gradle-wrapper.jar

# --- Desktop bundle / installers -------------------------------------------
dist/
app/build/
*.dmg

# --- Logs and runtime junk --------------------------------------------------
*.log
!benchmarks/*.json
logs/
*.pid

# --- IDE / editor -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Autonomous dev runner runtime state -----------------------------------
# The durable task queue and checkpoints ARE tracked; runtime state, worker
# logs, and the worker report are not.
.autodev/*
!.autodev/tasks.json
!.autodev/checkpoint-*.md
# --- Owner scratch copies (kept on disk, never shipped) ---------------------
# A stale 316-line copy of jarvis/security/providers.py; nothing imports it.
# Publishing it would ship dead duplicate code into a fresh clone.
*.py.multimodal
