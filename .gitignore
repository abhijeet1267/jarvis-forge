# Virtualenv and interpreter caches
# .venv holds 3,698 vendored files; __pycache__ holds 340 .pyc across three interpreters.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Build outputs — regenerated by build_app.py; dist/ also contains the stale launcher
# pointer audited in PHASE9_DESKTOP_AUDIT.md, so it must never be the committed artifact.
dist/
app/build/
*.spec

# Local state and secrets. .env may hold real credentials; the runtime data dir is
# ~/.jarvis-forge and deliberately not in-tree.
.env
.env.local
*.key
*.pem

# macOS
.DS_Store

# Autonomous dev runner (scripts/autodev). The durable task queue (tasks.json)
# IS tracked; runtime state, checkpoints, and worker logs are not.
.autodev/*
!.autodev/tasks.json
