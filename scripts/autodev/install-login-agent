#!/bin/bash
# Install a current-user LaunchAgent that resumes an UNEXPIRED autodev run at
# login. `autodev resume` is a no-op when no run is active, so a reboot never
# invents a new run. No admin privileges needed.
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
PLIST="$HOME/Library/LaunchAgents/com.vantage.autodev.plist"
LOGDIR="$REPO/.autodev/logs"

mkdir -p "$(dirname "$PLIST")" "$LOGDIR"

cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vantage.autodev</string>
  <key>ProgramArguments</key>
  <array>
    <string>$REPO/scripts/autodev/autodev</string>
    <string>resume</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$LOGDIR/login-resume.out.log</string>
  <key>StandardErrorPath</key>
  <string>$LOGDIR/login-resume.err.log</string>
</dict>
</plist>
EOF

launchctl bootout "gui/$(id -u)/com.vantage.autodev" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$PLIST"
echo "Installed $PLIST (registered for future logins; a one-shot resume ran now and is a no-op unless a run is active)."
echo "It only resumes an active, unexpired run; check with: scripts/autodev/autodev status"
echo "Remove with: scripts/autodev/uninstall-login-agent"
