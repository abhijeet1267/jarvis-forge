# ---------------------------------------------------------------------------
# JARVIS Forge - example environment configuration.
# Copy to .env and edit. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
JARVIS_ENV=dev
JARVIS_HOME=~/.jarvis-forge
JARVIS_LOG_LEVEL=INFO
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# --- Policy -----------------------------------------------------------------
# When true, every Level>=1 action is confirmed even if the tool says otherwise.
JARVIS_PARANOID=false
# Default confirmation channel: cli | api | watch
JARVIS_CONFIRM_CHANNEL=cli
# Seconds before a pending confirmation expires.
JARVIS_CONFIRM_TIMEOUT=300

# --- Model gateway (optional) ----------------------------------------------
# Leave blank to run fully offline with the deterministic rule-based planner.
# Any OpenAI-compatible endpoint works (OpenAI, Groq, Together, vLLM, Ollama...).
JARVIS_LLM_BASE_URL=
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=gpt-4o-mini
JARVIS_LLM_FAST_MODEL=gpt-4o-mini
JARVIS_LLM_REASONING_MODEL=o4-mini

# --- Safety -----------------------------------------------------------------
# Deleting a file always routes to the OS trash first (never hard-delete).
JARVIS_TRASH_ON_DELETE=true

# Commands JARVIS may run. Split deliberately.
#   allowed_commands  -- read-only/inspection tools. Safe to expose.
#   powerful_commands -- interpreters & package managers. Turing-complete:
#                        `python3 -c '...'` is arbitrary code execution and
#                        `npm install` runs arbitrary postinstall scripts.
#                        EMPTY by default. Opt in only if you accept that.
JARVIS_ALLOWED_COMMANDS=ls,cat,head,tail,wc,file,stat,echo,date,uptime,df,du,whoami,hostname,uname,pwd,sw_vers
JARVIS_POWERFUL_COMMANDS=

# --- API security -----------------------------------------------------------
# Token auth is ON by default. A localhost HTTP API that executes real actions
# is reachable by any web page you have open, so this is not opt-in.
JARVIS_AUTH_ENABLED=true
# Blank -> generated once at <home>/api_token with 0600 permissions.
# Read it to call the API yourself, e.g.
#   curl -H "X-JARVIS-Token: $(cat ~/.jarvis-forge/api_token)" http://127.0.0.1:8765/health
JARVIS_API_TOKEN=
# Extra browser origins allowed to call the API (comma-separated). The
# dashboard origin is always allowed. A wildcard "*" is ignored on purpose.
JARVIS_CORS_ORIGINS=
# Reject requests whose Host header is not a loopback name (anti DNS-rebinding).
JARVIS_ENFORCE_HOST_HEADER=true
# Token-bucket rate limiting, per client. Sized to leave headroom for the
# dashboard, which polls several endpoints every few seconds.
JARVIS_RATE_LIMIT_PER_MINUTE=600
JARVIS_RATE_LIMIT_BURST=120

# Pending confirmations expire after this many seconds. An approval nobody
# answers must not remain a standing authorisation.
JARVIS_CONFIRM_TIMEOUT=300

# --- Privacy (section 49) ---------------------------------------------------
# Credentials are ALWAYS redacted from audit records, log files and model
# prompts. Privacy mode is additive: it also masks personal identifiers (email
# addresses, phone numbers) and collapses home-directory paths to "~".
JARVIS_PRIVACY_MODE=false
# Set false only while debugging, and accept that secrets may reach the audit
# log. Redaction is verified not to alter ordinary text.
JARVIS_REDACT_AUDIT=true

# --- Voice (Phase 2) --------------------------------------------------------
JARVIS_VOICE_ENABLED=true
# Wake words accepted before a spoken command (comma-separated, fuzzy-matched).
JARVIS_WAKE_WORDS=jarvis,hey jarvis,ok jarvis
# Set false to accept commands without a wake word.
JARVIS_REQUIRE_WAKE_WORD=true

# Text to speech: auto | macos_say | pyttsx3 | null
JARVIS_TTS_BACKEND=auto
JARVIS_TTS_ENABLED=true
# Leave blank for the system default voice. `say -v '?'` lists all 180+.
JARVIS_TTS_VOICE=
# Words per minute.
JARVIS_TTS_RATE=180

# Speech to text: auto | macos_speech | whisper_cpp | openai_whisper | transcript
JARVIS_STT_BACKEND=auto
JARVIS_STT_LANGUAGE=en-US
# For whisper_cpp this is a .bin model path; for openai_whisper a model name.
JARVIS_STT_MODEL=whisper-1

# Audio capture (ffmpeg AVFoundation). ":1" is usually the built-in mic;
# run `ffmpeg -f avfoundation -list_devices true -i ""` to confirm.
JARVIS_AUDIO_DEVICE=:1
JARVIS_LISTEN_SECONDS=5
JARVIS_SAMPLE_RATE=16000
# Where synthesised speech and captured clips are written (blank = <home>/voice).
JARVIS_VOICE_DIR=

# --- Email (v0.7) -----------------------------------------------------------
# Leave blank to use the local maildir: real .eml files in <home>/mail/,
# no account required. Set all three of host + address + password to use a
# real IMAP/SMTP account instead.
JARVIS_EMAIL_ADDRESS=
JARVIS_EMAIL_PASSWORD=
JARVIS_EMAIL_IMAP_HOST=
JARVIS_EMAIL_IMAP_PORT=993
JARVIS_EMAIL_SMTP_HOST=
JARVIS_EMAIL_SMTP_PORT=465

# --- Calendar (v0.7) --------------------------------------------------------
# Leave blank to use the local SQLite calendar (full CRUD, works offline).
JARVIS_CALENDAR_URL=
JARVIS_CALENDAR_USER=
JARVIS_CALENDAR_PASSWORD=

# --- Car (v1.7) -------------------------------------------------------------
# Read-only vehicle telemetry (plan section 18). Leave every value blank and
# JARVIS honestly reports "no car adapter or vehicle API is configured" instead
# of inventing numbers. The manufacturer API wins over OBD-II if both are set.
#
# Mode B -- an ELM327 OBD-II adapter on a serial-over-TCP / Wi-Fi bridge:
#   host[:port][@protocol]   default port 35145, default protocol 6 (CAN 500k)
# Readiness is decided by the car's own PID-support bitmasks, so a metric the
# vehicle does not implement is reported as unavailable, never as a guess.
JARVIS_CAR_OBD=
# Seconds per adapter exchange (init, PID requests, multi-frame VIN).
JARVIS_CAR_TIMEOUT=3

# Mode A -- an official manufacturer / fleet vehicle API (JSON over HTTPS):
JARVIS_CAR_API_URL=
JARVIS_CAR_API_TOKEN=
JARVIS_CAR_API_PATH=/telemetry

# Deterministic demo vehicle. Every line is labelled "(simulated)" and it
# exposes only a subset of metrics, so simulate mode cannot fabricate a reading.
JARVIS_CAR_SIMULATE=

# --- Watch (v1.8) -----------------------------------------------------------
# A smartwatch is a companion that calls in, so these routes are the device's
# side of the link: POST /watch/collect (take what is queued, report battery),
# POST /watch/ack (it was displayed), POST /watch/reply (the wearer's button).
# The watch can only answer a prompt it was actually shown.
#
# Default: no bridge. Prompts stay in the outbox and every reply says "queued",
# never "sent to your watch".
JARVIS_WATCH_BRIDGE=
# Bearer token for the push relay, if it needs one.
JARVIS_WATCH_BRIDGE_TOKEN=
JARVIS_WATCH_TIMEOUT=3

# A deterministic companion that acknowledges deliveries, for demos and tests.
# It DELIVERS prompts; it never ANSWERS one, so it cannot approve anything.
JARVIS_WATCH_SIMULATE=

# Put confirmation prompts on the wrist automatically (plan section 25). The
# setting predates the watch and used to be a lie; with this set to "watch" a
# pending confirmation is queued to the companion and the reply says how far it
# got. Pair the watch first (it refuses while unpaired).
JARVIS_CONFIRM_CHANNEL=cli

# --- Vision OCR (v1.3, latency guard) ---------------------------------------
# How long to wait for the macOS Vision helper before giving up. Under load the
# framework intermittently never returns; a missed read says "no text was read"
# and the recogniser is then left alone for 45s rather than every later question
# waiting again. Clamped to 1-120 seconds.
JARVIS_OCR_TIMEOUT=20
